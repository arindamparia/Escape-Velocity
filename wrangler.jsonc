{
  "name": "escape-velocity",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "escape-velocity",
      "database_id": "0e785b86-4ea6-487a-b7fa-c09dc1f93bd3",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PLAN_TZ": "Asia/Kolkata",
    "OWNER_EMAIL": "arindamparia321@gmail.com",
    "ACCESS_TEAM_DOMAIN": "arindam-codes.cloudflareaccess.com",
    "ACCESS_AUD": "51fecbec76ae596526c6b8379a9957e63fe904bb5a52313899b0caa6c76ef460",
    "ALGOTRACKER_EMAIL": "arindamparia321@gmail.com"
  }
}
