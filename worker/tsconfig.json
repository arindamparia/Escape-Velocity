{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["./**/*.ts", "../shared/**/*.ts", "../src/lib/dates.ts", "../src/lib/srs.ts", "../src/generated/plan-core.json", "../src/generated/rag.json", "../tests/worker/**/*.ts"]
}
